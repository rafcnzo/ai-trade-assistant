@echo off
rem Dua cron job Hermes untuk crypto-analyst. Dicetak dengan path nyata oleh hermes/sync.py.
rem Jalankan sekali setelah `hermes gateway install`. Cek: hermes cron list

hermes cron create "1-59/5 * * * *" "Pemindai mekanis baru saja menemukan kandidat tiket; ringkasannya dengan ID K<id> ada di pesan ini. Jalankan skill tiket: (1) panggil mcp_paper_kandidat_terbaru(limit=3) dan nilai HANYA kandidat yang ID-nya disebut di ringkasan; (2) periksa fakta lewat tool mcp_paper_* (waktu_sekarang, budget_tiket, harga, ohlcv 15m lalu 5m, tabel_tiket dengan entry = level); (3) per kandidat: pasang order paper bersyarat (akun tiket, limit di level, TP, leverage dari tabel_tiket) dengan plan_id persis field plan_id kandidat (K<id>), atau SKIP dengan alasan; (4) mcp_paper_tulis_jurnal untuk setiap keputusan, isi kandidat_id; (5) jika kandidat_terbaru kosong atau status_data BASI, jawab satu baris dan berhenti. Balas ringkas untuk Telegram (maks 12 baris). Ini paper trading; jangan menyarankan beli/jual uang sungguhan." --name pemindai-tiket --skill tiket --script "{{HERMES_HOME}}\scripts\pemindai_cron.py" --deliver telegram --model claude-opus-5-5 --reasoning-effort low

hermes cron create "55 23 * * *" "Jalankan skill evaluasi-harian untuk hari ini (WIB): laporan paper, biaya API, catatan harian, maksimal 3 hipotesis terukur, usulan pelajaran bila ada pola berulang. Balas ringkas untuk Telegram (maks 20 baris)." --name evaluasi-harian --skill evaluasi-harian --deliver telegram --model claude-opus-5-5 --reasoning-effort low
